# Server Environment Configuration Template
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=<generate-a-secure-random-secret>
CLIENT_URL=https://your-frontend.vercel.app
CLIENT_URL_LOCAL=http://localhost:5173

# Administrator Account
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_INITIAL_PASSWORD=<secure-admin-password>

# Cloudinary Image Storage (required for evidence upload)
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
