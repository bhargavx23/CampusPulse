# CampusPulse Backend Environment Variables
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/campuspulse
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=https://campus-pulse-kq5b-ten.vercel.app/
CLIENT_URL_LOCAL:https://campus-pulse-kq5b-ten.vercel.app/

# Administrator Provisioning Configuration (Use placeholders only in .env.example)
ADMIN_EMAIL=admin@institution.edu
ADMIN_INITIAL_PASSWORD=your_secure_admin_initial_password_here

# Nodemailer SMTP Configuration for Password Reset (Gmail SMTP / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-verified-sender@gmail.com
SMTP_PASS=your-newly-generated-app-password
MAIL_FROM="CampusPulse Support <your-verified-sender@gmail.com>"
